FROM python:3.11-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    DJANGO_SETTINGS_MODULE=server_agri_map_django.settings.production

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    python3-dev \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements and install
COPY server-agri-map-django/requirements.txt ./
RUN pip install --no-cache-dir --default-timeout=180 -r requirements.txt || \
    pip install --no-cache-dir Django==4.2.0 djangorestframework==3.14.0 django-cors-headers

# Copy application code
COPY server-agri-map-django/ .


# Expose port
EXPOSE 8000

# Migrate, collect static assets, serve via gunicorn
# (docker-compose.yml overrides both settings module and command for local dev)
CMD ["bash", "startup.sh"]
