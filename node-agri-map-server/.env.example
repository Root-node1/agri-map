# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=
MONGODB_URI_PROD=

# JWT
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d


# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
DJANGO_API_URL=http://localhost:8000/api
DJANGO_API_KEY=your_django_api_key
ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/your_infura_project_id
ETHEREUM_CHAIN_ID=11155111  # Sepolia testnet
PRIVATE_KEY=0xabcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890
CARBON_TOKEN_CONTRACT=0x1234567890abcdef1234567890abcdef12345678
BLOCKCHAIN_GAS_LIMIT=2000000
BLOCKCHAIN_GAS_PRICE=20  
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:5000/api/paystack/callback
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
WEBHOOK_BASE_URL=http://localhost:5000/api/webhooks
WEBHOOK_LOAN_APPROVED=http://localhost:5000/api/webhooks/loan-approved
WEBHOOK_LOAN_DISBURSED=http://localhost:5000/api/webhooks/loan-disbursed
WEBHOOK_CARBON_VERIFIED=http://localhost:5000/api/webhooks/carbon-verified
WEBHOOK_PAYMENT_CONFIRMED=http://localhost:5000/api/webhooks/payment-confirmed
LOG_LEVEL=info
# AI Service Toggle
USE_PYTHON_AI=false

# Firebase
FIREBASE_PROJECT_ID=your_firebase_project_id
